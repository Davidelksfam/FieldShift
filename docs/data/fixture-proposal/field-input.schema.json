{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic FieldInput proposal 0.1; not the canonical application contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dataStatus",
    "requestId",
    "replayConfigId",
    "location",
    "areaHa",
    "cropHistory",
    "irrigationMethod",
    "waterBudget",
    "excludedCropIds",
    "baselinePlan",
    "objective",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "field-input-proposal-0.1"
    },
    "dataStatus": {
      "const": "synthetic_fixture"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "replayConfigId": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "point"
      ],
      "properties": {
        "regionId": {
          "enum": [
            "egypt-nile-delta",
            "egypt-fayoum"
          ]
        },
        "point": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "longitude",
            "latitude"
          ],
          "properties": {
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          }
        }
      }
    },
    "areaHa": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "cropHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "entries"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cropId",
              "startDate",
              "endDate"
            ],
            "properties": {
              "cropId": {
                "type": "string",
                "minLength": 1
              },
              "startDate": {
                "type": "string",
                "format": "date"
              },
              "endDate": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "entries": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "entries": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "irrigationMethod": {
      "enum": [
        "surface",
        "drip",
        "sprinkler",
        "other",
        "unknown"
      ]
    },
    "waterBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "accountingBoundary",
        "allocations"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "accountingBoundary": {
          "const": "field_inlet"
        },
        "allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "windowId",
              "availableM3"
            ],
            "properties": {
              "windowId": {
                "type": "string",
                "minLength": 1
              },
              "availableM3": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "allocations": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "allocations": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "excludedCropIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "baselinePlan": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "windowId",
              "cropId"
            ],
            "properties": {
              "windowId": {
                "type": "string",
                "minLength": 1
              },
              "cropId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "objective": {
      "enum": [
        "compare_only",
        "lower_irrigation_demand"
      ]
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
