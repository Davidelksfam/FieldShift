                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "unavailable"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "null"
                      },
                      "missingReason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "available"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "missingReason": {
                        "type": "null"
                      },
                      "sourceRefs": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            {
              "properties": {
                "unit": {
                  "const": "days"
                }
              }
            }
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "dataset",
          "csvPath",
          "csvSha256",
          "metadataPath",
          "metadataSha256",
          "nativeArtifactSha256",
          "sourceUrl"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "dataset": {
            "type": "string",
            "minLength": 1
          },
          "csvPath": {
            "type": "string",
            "minLength": 1
          },
          "csvSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "metadataPath": {
            "type": "string",
            "minLength": 1
          },
          "metadataSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "nativeArtifactSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "decisionReady": {
      "const": false
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
