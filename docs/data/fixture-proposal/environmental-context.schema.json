{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research EnvironmentalContext proposal 0.2; not a canonical application contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "regionId",
    "period",
    "spatialSupport",
    "metrics",
    "sources",
    "decisionReady",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "environmental-context-proposal-0.2"
    },
    "regionId": {
      "enum": [
        "egypt-nile-delta",
        "egypt-fayoum"
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startDate",
        "endDate",
        "kind"
      ],
      "properties": {
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "kind": {
          "const": "historical_observation_interval"
        }
      }
    },
    "spatialSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "point",
        "description"
      ],
      "properties": {
        "kind": {
          "const": "sampled_weather_query_point"
        },
        "point": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "longitude",
            "latitude"
          ],
          "properties": {
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meanAirTemperatureC",
        "periodRainfallMm",
        "heatExposureDays"
      ],
      "properties": {
        "meanAirTemperatureC": {
          "allOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit",
                "status",
                "dataStatus",
                "method",
                "sourceRefs",
                "coverage",
                "missingReason",
                "observedValue"
              ],
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "available",
                    "unavailable"
                  ]
                },
                "dataStatus": {
                  "enum": [
                    "historical_modeled",
                    "historical_observed",
                    "predicted",
                    "synthetic_fixture",
                    "unknown"
                  ]
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "coverage": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "validDays",
                    "expectedDays",
                    "validFraction"
                  ],
                  "properties": {
                    "validDays": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "expectedDays": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "validFraction": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "missingReason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "observedValue": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "unavailable"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "null"
                      },
                      "missingReason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "available"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "missingReason": {
                        "type": "null"
                      },
                      "sourceRefs": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            {
              "properties": {
                "unit": {
                  "const": "degC"
                }
              }
            }
          ]
        },
        "periodRainfallMm": {
          "allOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit",
                "status",
                "dataStatus",
                "method",
                "sourceRefs",
                "coverage",
                "missingReason",
                "observedValue"
              ],
              "properties": {
                "value": {
                  "type": [
