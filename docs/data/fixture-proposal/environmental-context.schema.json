                  ]
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "coverage": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "validDays",
                    "expectedDays",
                    "validFraction"
                  ],
                  "properties": {
                    "validDays": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "expectedDays": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "validFraction": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "missingReason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "observedValue": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "unavailable"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "null"
                      },
                      "missingReason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "available"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "missingReason": {
                        "type": "null"
                      },
                      "sourceRefs": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            {
              "properties": {
                "unit": {
                  "const": "mm"
                }
              }
            }
          ]
        },
        "heatExposureDays": {
          "allOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit",
                "status",
                "dataStatus",
                "method",
                "sourceRefs",
                "coverage",
                "missingReason",
                "observedValue"
              ],
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "available",
                    "unavailable"
                  ]
                },
                "dataStatus": {
                  "enum": [
                    "historical_modeled",
                    "historical_observed",
                    "predicted",
                    "synthetic_fixture",
                    "unknown"
                  ]
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "coverage": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "validDays",
                    "expectedDays",
                    "validFraction"
                  ],
                  "properties": {
                    "validDays": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "expectedDays": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "validFraction": {
                      "type": "number",
