{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Two CMR query-building shapes used by the research runner",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "short_name",
        "version",
        "page_size"
      ],
      "properties": {
        "short_name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "collection_concept_id",
        "point",
        "temporal",
        "page_size",
        "sort_key"
      ],
      "properties": {
        "collection_concept_id": {
          "type": "string",
          "minLength": 1
        },
        "point": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?,-?[0-9]+(\\.[0-9]+)?$"
        },
        "temporal": {
          "type": "string",
          "minLength": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "sort_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  ]
}
