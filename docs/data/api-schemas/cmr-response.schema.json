{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CMR collection/granule JSON; metadata, not science arrays",
  "type": "object",
  "required": [
    "feed"
  ],
  "properties": {
    "feed": {
      "type": "object",
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "links"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "href",
                    "rel"
                  ],
                  "properties": {
                    "href": {
                      "type": "string",
                      "format": "uri"
                    },
                    "rel": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
