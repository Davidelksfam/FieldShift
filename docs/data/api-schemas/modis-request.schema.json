{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ORNL MOD13Q1 synchronous subset query-building object",
  "type": "object",
  "required": [
    "latitude",
    "longitude",
    "startDate",
    "endDate",
    "kmAboveBelow",
    "kmLeftRight"
  ],
  "properties": {
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "startDate": {
      "type": "string",
      "pattern": "^A[0-9]{7}$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^A[0-9]{7}$"
    },
    "kmAboveBelow": {
      "type": "integer",
      "minimum": 0
    },
    "kmLeftRight": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
