{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delta and Fayoum seven-source import handoff",
  "type": "object",
  "required": [
    "schemaVersion",
    "configPath",
    "period",
    "allProductionComplete",
    "regions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "regional-readiness-1.0"
    },
    "configPath": {
      "type": "string"
    },
    "period": {
      "type": "object",
      "required": [
        "startDate",
        "endDateInclusive",
        "status"
      ],
      "properties": {
        "startDate": {
          "const": "2024-01-01"
        },
        "endDateInclusive": {
          "const": "2025-12-31"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "allProductionComplete": {
      "type": "boolean"
    },
    "regions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "regionId",
          "bbox",
          "sources"
        ],
        "properties": {
          "regionId": {
            "enum": [
              "egypt-nile-delta",
              "egypt-fayoum"
            ]
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "type": "object",
              "required": [
                "sourceId",
                "schemaStatus",
                "spatialStatus",
                "temporalStatus",
                "qualityStatus",
                "fullProductionReady",
                "evidencePaths",
                "missingRequirements"
              ],
              "properties": {
                "sourceId": {
                  "enum": [
                    "power",
                    "imerg",
                    "smap",
                    "hls",
                    "modis_mod13q1",
                    "ecostress",
                    "soilgrids"
                  ]
                },
                "schemaStatus": {
                  "const": "complete"
                },
                "spatialStatus": {
                  "type": "string",
                  "minLength": 1
                },
                "temporalStatus": {
                  "type": "string",
                  "minLength": 1
                },
                "qualityStatus": {
                  "type": "string",
                  "minLength": 1
                },
                "fullProductionReady": {
                  "type": "boolean"
                },
                "evidencePaths": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "missingRequirements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
