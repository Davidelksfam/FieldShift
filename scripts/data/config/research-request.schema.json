{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FieldShift bounded research request; semantic ordering checked by runner",
  "type": "object",
  "required": [
    "scope",
    "point",
    "startDate",
    "endDateInclusive",
    "soilSubsetWidthM"
  ],
  "properties": {
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "point": {
      "type": "object",
      "required": [
        "longitude",
        "latitude"
      ],
      "properties": {
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      "additionalProperties": false
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "endDateInclusive": {
      "type": "string",
      "format": "date"
    },
    "soilSubsetWidthM": {
      "type": "number",
      "minimum": 250,
      "maximum": 2000
    }
  },
  "additionalProperties": false
}
