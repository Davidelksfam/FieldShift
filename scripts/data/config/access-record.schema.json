{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FieldShift research access/provenance record; not a model contract",
  "type": "object",
  "required": [
    "sourceId",
    "retrievedAt",
    "status",
    "scienceDownloaded",
    "artifacts",
    "scope",
    "eligibilityStatus"
  ],
  "properties": {
    "sourceId": {
      "enum": [
        "power",
        "imerg",
        "smap",
        "hls",
        "modis_mod13q1",
        "ecostress",
        "soilgrids"
      ]
    },
    "retrievedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "not_attempted",
        "science_downloaded",
        "requires_authentication",
        "science_accessible_not_downloaded",
        "no_matching_granules",
        "http_error",
        "acquisition_error"
      ]
    },
    "scienceDownloaded": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "byteCount",
          "kind",
          "sourceUrl"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byteCount": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "catalog",
              "science"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "scope": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FieldShift bounded research request; semantic ordering checked by runner",
      "type": "object",
      "required": [
        "scope",
        "point",
        "startDate",
        "endDateInclusive",
        "soilSubsetWidthM"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "point": {
          "type": "object",
          "required": [
            "longitude",
            "latitude"
          ],
          "properties": {
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          "additionalProperties": false
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDateInclusive": {
          "type": "string",
          "format": "date"
        },
        "soilSubsetWidthM": {
          "type": "number",
          "minimum": 250,
          "maximum": 2000
        }
      },
      "additionalProperties": false
    },
    "eligibilityStatus": {
      "const": "pending_resources_tab_verification"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "science_downloaded"
          }
        }
      },
      "then": {
        "properties": {
          "scienceDownloaded": {
            "const": true
          },
          "artifacts": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "science"
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        }
      }
    }
  ]
}
